rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && profile().status != "disabled";
    }

    function verifiedOrganizationMember(organizationId, expectedType) {
      let membershipPath = /databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid);
      let organization = get(/databases/$(database)/documents/organizations/$(organizationId)).data;
      let membership = get(membershipPath).data;
      return activeUser()
        && profile().organizationId == organizationId
        && profile().role == expectedType
        && organization.type == expectedType
        && organization.verificationStatus == "verified"
        && exists(membershipPath)
        && membership.organizationId == organizationId
        && membership.userId == request.auth.uid
        && membership.status == "active";
    }

    function bloodBankMember(bloodBankId) {
      return verifiedOrganizationMember(bloodBankId, "bloodBank");
    }

    function hospitalMember(hospitalId) {
      return verifiedOrganizationMember(hospitalId, "hospital");
    }

    function trustedAdmin() {
      return activeUser()
        && profile().role == "administrator"
        && request.auth.token.admin == true;
    }

    function validInventoryRecord(data) {
      return data.keys().hasAll([
          "bloodBankId", "componentType", "bloodGroup", "rhFactor",
          "unitsAvailable", "unitsReserved", "collectionDate", "expiryDate",
          "storageLocation", "status", "createdAt", "updatedAt"
        ])
        && data.bloodBankId is string
        && data.bloodBankId.size() > 0
        && data.componentType in [
          "wholeBlood", "redCells", "plasma", "platelets", "cryoprecipitate"
        ]
        && data.status in [
          "available", "reserved", "dispatched", "expired",
          "quarantined", "discarded"
        ]
        && (
          (data.bloodGroup in ["A+", "B+", "O+", "AB+"] && data.rhFactor == "positive")
          || (data.bloodGroup in ["A-", "B-", "O-", "AB-"] && data.rhFactor == "negative")
        )
        && data.unitsAvailable is int
        && data.unitsAvailable >= 0
        && data.unitsAvailable <= 9007199254740991
        && data.unitsReserved is int
        && data.unitsReserved >= 0
        && data.unitsReserved <= 9007199254740991
        && data.collectionDate is timestamp
        && data.expiryDate is timestamp
        && data.collectionDate <= data.expiryDate
        && data.storageLocation is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /donorProfiles/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "userId", "bloodGroup", "rhFactor", "city", "phone",
          "availabilityStatus", "consentToEmergencyContact", "updatedAt"
        ]);
      allow update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "bloodGroup", "rhFactor", "city", "phone",
          "availabilityStatus", "consentToEmergencyContact", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if activeUser() && resource.data.donorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /bloodInventory/{inventoryId} {
      allow read: if bloodBankMember(resource.data.bloodBankId) || trustedAdmin();
      allow create: if bloodBankMember(request.resource.data.bloodBankId)
        && validInventoryRecord(request.resource.data)
        && request.resource.data.keys().hasOnly([
          "bloodBankId", "componentType", "bloodGroup", "rhFactor",
          "unitsAvailable", "unitsReserved", "collectionDate", "expiryDate",
          "storageLocation", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if bloodBankMember(resource.data.bloodBankId)
        && request.resource.data.bloodBankId == resource.data.bloodBankId
        && request.resource.data.createdAt == resource.data.createdAt
        && validInventoryRecord(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "componentType", "bloodGroup", "rhFactor", "storageLocation",
          "collectionDate", "expiryDate", "status", "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if bloodBankMember(organizationId) || hospitalMember(organizationId) || trustedAdmin();
      allow update: if (bloodBankMember(organizationId) || hospitalMember(organizationId))
        && request.resource.data.type == resource.data.type
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "legalName", "registrationNumber", "email", "phone",
          "address", "city", "state", "country", "updatedAt"
        ]);
      allow create, delete: if false;
    }

    match /organizationRequests/{requestId} {
      allow read: if activeUser()
        && (resource.data.requesterUserId == request.auth.uid
          || resource.data.requestedBy == request.auth.uid);
      allow create, update, delete: if false;
      allow update, delete: if false;
    }

    match /patients/{patientId} {
      allow read: if activeUser()
        && profile().role == "hospital"
        && resource.data.hospitalId == profile().organizationId;
      allow create: if hospitalMember(request.resource.data.hospitalId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hospitalMember(resource.data.hospitalId)
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if hospitalMember(resource.data.hospitalId);
    }

    match /bloodRequests/{requestId} {
      allow read: if hospitalMember(resource.data.hospitalId) || trustedAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /bloodRequestEvents/{eventId} {
      allow read: if trustedAdmin()
        || hospitalMember(get(/databases/$(database)/documents/bloodRequests/$(resource.data.requestId)).data.hospitalId);
      allow create: if false;
      allow update, delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if trustedAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || trustedAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["donor", "hospital", "bloodBank", "pending"]
        && request.resource.data.requestedRole is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "name", "email", "phone", "role", "requestedRole",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /organizationMembers/{membershipId} {
      allow read: if trustedAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeUser()
        && resource.data.recipientUserId == request.auth.uid;
      allow update: if activeUser()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create, delete: if false;
    }
  }
}
