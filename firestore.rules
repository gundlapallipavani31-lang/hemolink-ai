rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && profile().status != "disabled";
    }

    function bloodBankMember(bloodBankId) {
      return activeUser()
        && profile().role == "bloodBank"
        && profile().organizationId == bloodBankId;
    }

    function hospitalMember(hospitalId) {
      return activeUser()
        && profile().role == "hospital"
        && profile().organizationId == hospitalId;
    }

    function trustedAdmin() {
      return activeUser()
        && profile().role == "administrator"
        && request.auth.token.admin == true;
    }

    match /donorProfiles/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow create: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          "userId", "bloodGroup", "rhFactor", "city", "phone",
          "availabilityStatus", "consentToEmergencyContact", "updatedAt"
        ]);
      allow update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "bloodGroup", "rhFactor", "city", "phone",
          "availabilityStatus", "consentToEmergencyContact", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if activeUser() && resource.data.donorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /bloodInventory/{inventoryId} {
      allow read: if bloodBankMember(resource.data.bloodBankId) || trustedAdmin();
      allow create: if bloodBankMember(request.resource.data.bloodBankId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if bloodBankMember(resource.data.bloodBankId)
        && request.resource.data.bloodBankId == resource.data.bloodBankId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "componentType", "bloodGroup", "rhFactor", "storageLocation",
          "status", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if bloodBankMember(organizationId) || hospitalMember(organizationId) || trustedAdmin();
      allow update: if (bloodBankMember(organizationId) || hospitalMember(organizationId))
        && request.resource.data.type == resource.data.type
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "legalName", "registrationNumber", "email", "phone",
          "address", "city", "state", "country", "updatedAt"
        ]);
      allow create, delete: if false;
    }

    match /organizationRequests/{requestId} {
      allow read: if activeUser() && resource.data.requestedBy == request.auth.uid;
      allow create: if activeUser()
        && profile().role == "hospital"
        && !profile().organizationId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    match /patients/{patientId} {
      allow read: if activeUser()
        && profile().role == "hospital"
        && resource.data.hospitalId == profile().organizationId;
      allow create: if hospitalMember(request.resource.data.hospitalId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hospitalMember(resource.data.hospitalId)
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if hospitalMember(resource.data.hospitalId);
    }

    match /bloodRequests/{requestId} {
      allow read: if hospitalMember(resource.data.hospitalId) || trustedAdmin();
      allow create: if hospitalMember(request.resource.data.hospitalId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.unitsFulfilled == 0
        && (
          (
            request.resource.data.urgency == "emergency"
            && request.resource.data.patientId == null
            && request.resource.data.patientName is string
            && request.resource.data.caseId is string
          )
          || (
            request.resource.data.patientId is string
            && get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.hospitalId
              == request.resource.data.hospitalId
          )
        );
      allow update: if hospitalMember(resource.data.hospitalId)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "cancelled"
        && resource.data.status in ["submitted", "under_review"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
      allow delete: if false;
    }

    match /bloodRequestEvents/{eventId} {
      allow read: if trustedAdmin()
        || hospitalMember(get(/databases/$(database)/documents/bloodRequests/$(resource.data.requestId)).data.hospitalId);
      allow create: if hospitalMember(
          get(/databases/$(database)/documents/bloodRequests/$(request.resource.data.requestId)).data.hospitalId
        )
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.eventType in ["created", "cancelled"];
      allow update, delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if trustedAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || trustedAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["donor", "hospital", "bloodBank", "pending"]
        && request.resource.data.requestedRole is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "name", "email", "phone", "role", "requestedRole",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /organizationMembers/{membershipId} {
      allow read: if trustedAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeUser()
        && resource.data.recipientUserId == request.auth.uid;
      allow update: if activeUser()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create, delete: if false;
    }
  }
}
